# AutoPathingFTC — local configuration template
# Copy to .env and edit. .env is git-ignored; never commit it.
# No secrets or API keys are required by this project.

# ---- macOS app build (scripts/build-macos-app.sh) ----
APP_NAME=AutoPathingFTC
# Reverse-DNS bundle identifier. Use a domain you control (e.g. io.github.<your-username>.autopathingftc)
BUNDLE_ID=io.github.your-username.autopathingftc
# "-" = ad-hoc signing. Use a "Developer ID Application: …" identity for notarized distribution.
SIGN_IDENTITY=-
INSTALL_DIR=/Applications
MIN_MACOS=12.0

# ---- Runtime (optional) ----
# Only read when the app is launched from a terminal, e.g.:
#   AUTOPATHING_TEAMCODE_DIR=... open -a AutoPathingFTC   (or run the binary directly)
# Otherwise use "File ▸ Set TeamCode Folder…" inside the app.
AUTOPATHING_TEAMCODE_DIR=~/AndroidStudioProjects/FtcRobotController/TeamCode/src/main/java/org/firstinspires/ftc/teamcode
